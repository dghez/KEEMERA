{
    "name": "@dghez/keemera",
    "version": "0.1.4",
    "description": "A self-contained, multi-instance Three.js starter library: renderer, camera, loop, events, viewport, resources and reusable shards.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "skills"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./shards": "./dist/shards/index.js",
        "./helpers": "./dist/helpers/index.js",
        "./shaders": "./dist/shaders/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "vite --config examples/basic/vite.config.js",
        "build": "vite build",
        "prepare": "npm run build",
        "lint": "eslint src examples",
        "release": "npm version",
        "postversion": "git push --follow-tags"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "@monogrid/gainmap-js": ">=3",
        "gsap": ">=3.12",
        "three": ">=0.180"
    },
    "peerDependenciesMeta": {
        "@monogrid/gainmap-js": {
            "optional": true
        }
    },
    "dependencies": {
        "@use-gesture/vanilla": "^10.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "eslint": "^10.11.0",
        "globals": "^17.13.0",
        "gsap": "^3.15.0",
        "lenis": "^1.3.26",
        "postprocessing": "^6.39.5",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.1",
        "vite": "^8.3.2"
    },
    "keywords": [
        "three",
        "threejs",
        "webgl",
        "starter",
        "gsap"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
